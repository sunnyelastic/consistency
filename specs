.river__img { width: 600px; padding: 0 16px 6.5px; } .river__img img { width: 568px; max-width: 100%; aspect-ratio: 568/319.5; display: block; box-shadow: var(--shadow-fig); object-fit: cover; }
/* data table (2.27) */
.dtable-wrap { width: 1260px; max-width: 100%; margin: 0 auto; overflow-x: auto; }
.dtable { width: 1260px; border-collapse: collapse; table-layout: fixed; background: #fff; }
