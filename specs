.itc__fig { width: 853.33px; flex: none; padding: 0 16px 6.5px; }
.itc__fig img { width: 821.31px; max-width: 100%; aspect-ratio: 821.31/461.99; display: block; box-shadow: var(--shadow-fig); object-fit: cover; }
/* river cards (2.26) */
.river { width: 1280px; max-width: 100%; margin: 0 auto; padding: 0 16px 40px; display: flex; flex-direction: column; align-items: center; gap: 104px; }
.river__tabs { width: 100%; display: flex; justify-content: center; border-bottom: 1px solid var(--c-rule-2); }
.river__tab { min-width: 180px; height: 110px; padding: 16px; background: none; border: 0; border-bottom: 4px solid transparent; margin-bottom: -1px; cursor: pointer; display: flex; flex-direction: column; align-items: center; font: 400 16px/26px var(--f-body); letter-spacing: -0.32px; color: var(--c-ink); }
.river__tab img { width: 32px; height: 32px; margin-bottom: 16px; }
