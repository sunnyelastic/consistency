.tabs__btn { margin: 0 12px; padding: 9px 0; background: none; border: 0; border-bottom: 4px solid transparent; font: 400 16px/26px var(--f-body); letter-spacing: -0.32px; color: var(--c-ink); cursor: pointer; }
.tabs__btn[aria-selected="true"] { border-bottom-color: var(--c-blue); padding-bottom: 13px; }
