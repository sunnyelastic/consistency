.tabs__panel img { width: 100%; aspect-ratio: 1040/585.23; display: block; object-fit: cover; }
.cap12 { font: 400 12px/15.6px var(--f-body); color: var(--c-ink); text-align: center; }
/* code carousel (2.23) */
.code { display: flex; width: 1280px; max-width: 100%; margin: 0 auto; min-height: 500px; }
.code__tabs { width: 320px; flex: none; padding: 0 16px; }
