/* image text carousel / accordion tabs (2.24) */
.itc { display: flex; width: 1280px; max-width: 100%; margin: 0 auto; min-height: 468.49px; }
.itc__tabs { width: 426.66px; flex: none; padding: 0 16px; margin-top: -1px; }
