.qname { font: 700 24px/31.2px var(--f-display); color: var(--c-ink); }
.qrole { font: 400 18px/26px var(--f-display); color: var(--c-ink); margin-top: 3px; padding-bottom: 16px; }
.qlink { padding-top: 16px; }
/* quote carousel (2.11) */
.qcar { position: relative; height: 756px; }
.qcar__track { position: absolute; top: 0.81px; left: 0; right: 0; height: 743px; overflow: hidden; }
.qcar__slide { position: absolute; inset: 0; opacity: 0; visibility: hidden; transition: opacity .3s; }
