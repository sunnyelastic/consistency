.igrid--c > div { display: flex; flex-direction: column; align-items: center; text-align: center; }
.igrid--c .igrid__ico img { width: 64px; height: 64px; }
.ig22 { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); grid-auto-rows: 276.7px; gap: 64px; width: 1248px; max-width: calc(100% - 32px); margin: 0 auto; }
.ig22 > div { align-self: start; }
.ig22 .igrid__ico { margin-bottom: -0.75px; }
.ig22 .topic { padding-bottom: 16px; }
.ig32 { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); grid-auto-rows: 255.42px; gap: 64px; width: 1248px; max-width: calc(100% - 32px); margin: 0 auto; }
.ig32 > div { align-self: start; }
/* clickable list (2.18 / 2.19) */
.clist { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); grid-auto-rows: 166.5px; gap: 32px; width: 1248px; max-width: calc(100% - 32px); margin: 0 auto; }
.citem { align-self: start; display: flex; flex-direction: column; justify-content: space-between; padding: 16px; border-radius: 10px; color: inherit; transition: background-color .15s, box-shadow .15s; }
.citem:hover { box-shadow: var(--shadow-fig); }
.citem__top { display: flex; align-items: flex-start; }
.citem__top img { width: 32px; height: 32px; margin-right: 16px; margin-bottom: 22.5px; }
.citem__top .h4 { padding-bottom: 16px; }
.citem .body16 { padding-bottom: 8px; }
.citem__arrow { padding: 5.64px 0 3.36px; } .citem__arrow img { width: 27px; height: 15px; display: block; }
/* split: header left, 2x2 grid right (2.19) */
.split { display: grid; grid-template-columns: minmax(0,.6fr) minmax(0,1fr); gap: 64px; width: 1280px; max-width: 100%; margin: 0 auto; padding: 0.8px 16px 0; }
.split__head { width: 438.97px; padding: 0 16px; }
.split__head .h2, .split__head .topic { text-align: left; }
.split__head .bm-cta { justify-content: flex-start; }
.split__grid { display: grid; grid-template-columns: repeat(2, 338px); grid-auto-rows: 255.42px; gap: 64px; }
.split__grid > div { align-self: start; }
.igt { width: 1280px; max-width: 100%; margin: 0 auto; padding: 64px 16px 0; display: flex; flex-direction: column; align-items: center; gap: 32px; }
.igt__fig { width: 1040px; max-width: 100%; padding: 0 16px 6.5px; }
.igt__fig img { width: 1008px; max-width: 100%; aspect-ratio: 1008/566.49; display: block; box-shadow: var(--shadow-fig); object-fit: cover; }
.igt .igrid { width: 100%; max-width: none; padding-top: 32px; }
.foot14 { font: 400 14.1px/21.12px var(--f-body); color: var(--c-ink); text-align: center; width: 832px; max-width: 100%; }
.card--line { box-shadow: none; border: 1px solid var(--c-rule-2); padding: 33px 33px 32.99px; align-items: stretch; }
.h24 { font: 600 24px/28.8px var(--f-display); letter-spacing: -0.48px; color: var(--c-ink); padding-bottom: 16px; }
.cards--top { align-items: flex-start; }
/* tabs (2.22) */
.tabs { width: 1040px; max-width: calc(100% - 32px); margin: 0 auto; padding-bottom: 32px; display: flex; flex-direction: column; gap: 32px; }
.tabs__list { display: flex; justify-content: center; height: 49px; border-bottom: 1px solid var(--c-rule-2); }
