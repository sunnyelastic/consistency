<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Redesign specs: modules in the new type scale</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@100..900&family=Inter:wght@100..900&display=swap" rel="stylesheet">
<style>/* ==========================================================================
   Elastic hero templates — shared foundation
   Values taken 1:1 from spec 1920px frames.
   ========================================================================== */

@import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap");

/* Titles: Mier B. Uses the installed font if present, otherwise files in ./fonts,
   otherwise falls back to Inter. */
@font-face {
  font-family: "Mier B";
  src: local("Mier B Demi"), local("MierB-Demi"), local("Mier B"),
       url("fonts/MierB-Demi.woff2") format("woff2");
  font-weight: 600;
  font-style: normal;
  font-display: swap;
}

:root {
  /* color */
  --c-ink: #1c1e23;          /* headings, body */
  --c-ink-2: #343741;        /* nav, utility text */
  --c-blue: #0b64dd;         /* primary action */
  --c-white: #ffffff;
  --c-rule: #eeeff1;         /* header bottom border */
  --c-rule-2: #d4dae5;       /* utility bar inset line */
  --c-pipe: rgba(0, 0, 0, 0.2);
  --c-pink: #f04e98;
  --c-teal: #02bcb7;

  /* type */
  --f-display: "Mier B", "Inter", system-ui, sans-serif;
  --f-body: "Inter", system-ui, sans-serif;

  /* layout */
  --page-w: 1920px;
  --content-w: 1280px;       /* main section inner width (px 320 at 1920) */
  --header-h: 118px;         /* page content top offset */
  --radius-btn: 4px;
}

*, *::before, *::after { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }
body {
  background: var(--c-white);
  color: var(--c-ink);
  font-family: var(--f-body);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
}
img { display: block; max-width: none; }
a { color: inherit; text-decoration: none; }
p { margin: 0; }
h1, h2, h3, h4 { margin: 0; font-weight: 600; }
:focus-visible { outline: 2px solid var(--c-blue); outline-offset: 2px; }

.page {
  position: relative;
  background: var(--c-white);
}
.page__main { padding-top: var(--header-h); }

/* ==========================================================================
   Global header (identical across all templates)
   ========================================================================== */
.gh {
  position: absolute; top: 0; left: 0; right: 0;
  z-index: 10;
  background: var(--c-white);
  border-bottom: 1px solid var(--c-rule);
  display: flex; flex-direction: column; align-items: center;
}

/* utility bar */
.gh-util {
  position: relative; width: 100%; height: 38px;
  background: var(--c-white);
  display: flex; align-items: center; justify-content: center;
  box-shadow: inset 0 -0.5px 0 0 var(--c-rule-2);
}
.gh-util__inner {
  width: 1300px; padding: 0 16px;
  display: flex; align-items: center; justify-content: space-between;
}
.gh-promo { display: flex; gap: 4px; height: 32px; align-items: stretch; overflow: hidden; }
.gh-promo__dot { display: flex; align-items: center; }
.gh-promo__dot img { width: 10px; height: 10px; }
.gh-promo__text { position: relative; display: flex; align-items: center; max-width: 450px; padding-right: 4px; }
.gh-promo__text::before, .gh-promo__text::after { content: none; position: absolute; top: 0; width: 20px; height: 32px; }
.gh-promo__text::before { left: 0; background: linear-gradient(90deg, #fff, rgba(255,255,255,0)); }
.gh-promo__text::after { right: 0; background: linear-gradient(270deg, #fff, rgba(255,255,255,0)); }
.gh-util__txt { font: 400 14px/14px var(--f-body); color: var(--c-ink-2); white-space: nowrap; }
.gh-util__txt--link { color: var(--c-blue); }
.gh-promo__link { display: flex; align-items: center; }

.gh-util__right { display: flex; gap: 16px; align-items: center; }
.gh-util__pipe { font: 400 16px/16px var(--f-body); color: var(--c-pipe); }
.gh-lang { display: flex; align-items: center; padding: 7px 0 8px; background: none; border: 0; cursor: pointer; }
.gh-lang img.globe { width: 16px; height: 16px; }
.gh-lang__code { padding-left: 4px; font: 400 13px/13px var(--f-body); letter-spacing: 0.325px; color: var(--c-ink-2); }
.gh-lang__chev { height: 19px; padding-bottom: 1px; display: flex; align-items: center; }
.gh-lang__chev img { width: 18px; height: 18px; }
.gh-login { display: flex; gap: 4px; align-items: center; }
.gh-login img { width: 16px; height: 16px; }

/* main bar */
.gh-main { width: 1300px; height: 80px; padding: 0 16px; display: flex; align-items: center; gap: 16px; }
.gh-logo { display: block; width: 117px; height: 40px; overflow: hidden; position: relative; }
.gh-logo img { position: absolute; top: 0; left: 0; bottom: 0; right: 0.28%; width: 99.72%; height: 100%; }

.gh-nav { flex: 1 0 0; height: 64px; position: relative; }
.gh-nav__list { position: absolute; left: 0; right: 0; top: -1px; display: flex; align-items: center; max-height: 64px; list-style: none; margin: 0; padding: 0; }
.gh-nav__btn {
  display: flex; align-items: center; padding: 24px 8px;
  background: none; border: 0; cursor: pointer;
  font: 600 16px/16px var(--f-display); color: var(--c-ink-2); white-space: nowrap;
}
.gh-nav__btn img { width: 18px; height: 18px; }

.gh-actions { display: flex; gap: 14px; align-items: center; }
.gh-main > .gh-actions { margin-left: auto; }
.gh-search { position: relative; display: flex; }
.gh-search::before {
  content: ""; position: absolute; inset: -2px; border-radius: 1600px; opacity: 0.17;
  background-image: linear-gradient(90deg, var(--c-pink) 0%, var(--c-teal) 25%, var(--c-pink) 50%, var(--c-teal) 75%, var(--c-pink) 100%);
}
.gh-search__btn {
  position: relative; display: flex; gap: 8px; align-items: flex-start;
  padding: 9px 24px 9px 16px; border: 0; border-radius: 1600px; background: var(--c-white);
  font: 600 16px/24px var(--f-display); color: var(--c-ink-2); cursor: pointer;
}
.gh-search__btn img { width: 22px; height: 21px; }

/* ==========================================================================
   Buttons
   ========================================================================== */
.btn {
  display: inline-flex; align-items: center; justify-content: center;
  border: 2px solid var(--c-blue); border-radius: var(--radius-btn);
  font: 600 16px/24px var(--f-display); text-align: center; white-space: nowrap;
  cursor: pointer;
}
.btn--primary { background: var(--c-blue); color: var(--c-white); }
.btn--secondary { background: transparent; color: var(--c-blue); }
.btn--hdr { padding: 10px 26px; }                       /* header: 44px tall */
.btn--hero { height: 50px; min-width: 140px; padding: 0 26px; }  /* spec: min-h = max-h = 50px (2px border included) */

/* "Return to …" text link with long arrow (inline so it can wrap on mobile) */
.tlink {
  display: inline-block; text-align: left; height: 25.72px; padding-top: 1.47px;
  font: 600 16px/24px var(--f-display); color: var(--c-blue); white-space: nowrap;
}
.tlink__arrow { display: inline-block; vertical-align: top; width: 27px; height: 15px; margin: 6.75px 0 0 8px; overflow: hidden; }
.tlink__arrow img { width: 27px; height: 15px; }

/* ==========================================================================
   Hero primitives (shared by many templates)
   ========================================================================== */
.hero { position: relative; overflow: hidden; }
.hero__inner { width: 100%; max-width: var(--content-w); margin: 0 auto; }

.h-display {
  font: 600 60px/72px var(--f-display); letter-spacing: -1.2px; color: var(--c-ink);
}
.h-lede { font: 400 20px/30px var(--f-body); color: var(--c-ink); }
.hero-ctas { display: flex; gap: 24px; align-items: center; }

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation: none !important; transition: none !important; }
}

/* ==========================================================================
   Split hero (text left 4/12, media right) — 1.3 family
   ========================================================================== */
.hs { padding: 96px 0 64px; }
.hs__row { display: flex; flex-wrap: wrap; align-items: stretch; }
.hs__text { width: 41.6664%; padding: 0 16px; display: flex; align-items: center; }
.hs__text .h-display { padding-bottom: 16px; }
.hs__text .h-lede { padding-bottom: 8.25px; }
.hs__text .hero-ctas { padding-top: 24px; }
.hs__media { width: 58.3333%; padding-left: 8.3333%; display: flex; flex-direction: column; justify-content: center; }
.hs__media-in { padding: 32px 16px 6.5px; }
.hs__media img { width: 100%; aspect-ratio: 608 / 405.33; max-height: 500px; object-fit: cover; }
.hs__media-in--video { padding-bottom: 0; }
.video-fig.video-fig--light { background: #fff; }

.btn__ico { width: 16px; height: 16px; margin-left: 8px; }
.dl-link { display: inline-flex; gap: 8px; align-items: center; height: 24px; margin-top: 24px;
  font: 600 16px/24px var(--f-display); color: var(--c-blue);
  text-decoration: underline; text-decoration-thickness: 1px; text-underline-position: from-font; text-decoration-skip-ink: none; }
.dl-link img { width: 16px; height: 16px; }

/* centered hero (1.1 family) */
.hc { padding: 96px 0 64px; }
.hc__text { width: 66.6667%; margin: 0 auto; padding: 0 16px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
.hc__text .h-display { padding-bottom: 16px; }
.hc__text .h-lede { padding-bottom: 8px; }
.hc__text .hero-ctas { padding-top: 24px; }
.hc__media { width: 83.3333%; margin: 0 auto; padding: 80px 16px 6.5px; }
.hc__media img { width: 100%; aspect-ratio: 1034.66 / 689.77; object-fit: cover; }
.hc__media--video { padding-bottom: 0; }
.video-fig { margin: 0; width: 100%; aspect-ratio: 16 / 9; background: #151515;
  box-shadow: 0 10px 20px 0 rgba(83,89,102,0.1), 0 2px 6px 0 rgba(83,89,102,0.25); }

/* header pieces that only exist below desktop */
.gh-lang--bar, .gh-burger { display: none; }
.gh-burger { position: relative; width: 32px; height: 32px; margin: 3px 0 3.5px; padding: 0; background: none; border: 0; cursor: pointer; }
.gh-burger span { position: absolute; left: 50%; width: 18px; height: 1.5px; transform: translateX(-50%); border-radius: 1600px; background: var(--c-ink-2); }
.gh-burger span:nth-child(1) { top: 9px; } .gh-burger span:nth-child(2) { top: 14.5px; } .gh-burger span:nth-child(3) { top: 20px; }

/* ==========================================================================
   Tablet  (specs at 768px)
   ========================================================================== */
@media (max-width: 1023.98px) {
  :root { --header-h: 110px; }
  .gh-util__inner { width: 100%; }
  .gh-util__right, .gh-nav, .gh-actions .btn { display: none; }
  .gh-main { width: 100%; height: 72px; justify-content: space-between; }
  .gh-lang--bar, .gh-burger { display: flex; }
  .gh-lang--bar { margin-top: 4px; margin-bottom: 4px; }
  .gh-actions { gap: 14px; }

  .hero__inner { max-width: 768px; }
  .h-display--t { font-size: 44.6px; line-height: 53.5px; letter-spacing: -0.892px; }

  /* split hero stacks and centers */
  .hs { padding: 64px 0 48px; }
  .hs__row { flex-direction: column; height: auto !important; }
  .hs__text { width: 83.3333%; padding: 0 16px 0 calc(16.6667% + 16px); justify-content: center; text-align: center; }
  .hs__text > div { width: 100%; display: flex; flex-direction: column; align-items: center; }
  .hs__text .h-display { padding: 0 0 16px !important; }
  .hs__text .h-lede { padding: 0 0 8px !important; }
  .hs__media { width: 91.6667%; padding-left: 8.3333%; }
  .hs__media-in { padding-top: 48px; }

  .hc { padding: 64px 0 48px; }
  .hc__text { width: 83.3333%; margin: 0; padding: 0 16px 0 calc(16.6667% + 16px); }
  .hc__media { width: 91.6667%; margin: 0; padding: 80px 16px 6.5px calc(8.3333% + 16px); }
  .hc__media img { aspect-ratio: 608 / 405.33; }
  .video-fig { background: #000; }
  .video-fig.video-fig--light { background: rgba(255,255,255,0); }
}

/* ==========================================================================
   Mobile  (specs at 360px)
   ========================================================================== */
@media (max-width: 767.98px) {
  :root { --header-h: 102px; }
  .gh-promo { width: 100%; }
  .gh-promo__text { flex: 1 0 0; min-width: 0; max-width: none; overflow: hidden; padding-right: 0; }
  .gh-promo__text::before, .gh-promo__text::after { content: ""; }
  .gh-promo__text .gh-util__txt { padding-right: 14.97px; }
  .gh-promo .gh-util__txt { font-size: 13px; line-height: 13px; }
  .gh-main { height: 64px; }
  .gh-actions { gap: 8px; }
  .gh-search { margin-left: 4px; }
  .gh-search__btn { padding: 8px; font-size: 0; gap: 0; width: 38px; height: 37px; }

  .h-display--t { font-size: 36px; line-height: 43.2px; letter-spacing: -0.72px; }
  .hero-ctas .btn--hero { height: auto; min-height: 50px; padding: 8px 26px; white-space: normal; flex: 1 1 auto; }
  .btn--hero .btn__ico { flex-shrink: 1; min-width: 0; object-fit: cover; object-position: left; }
  .hero-ctas .tlink { flex: 0 1 164px; height: auto; white-space: normal; line-height: 25.72px; margin-top: 10px; }

  .hero__inner { max-width: none; }
  .hs { padding: 48px 0 32px; }
  .hs__text { width: 100%; padding: 0 16px; }
  .hs__media { width: 100%; padding: 0; }
  .hs__media-in { padding: 48px 16px 6.5px; }
  .hs__media img { aspect-ratio: 328 / 218.66; }

  .hc { padding: 48px 0 32px; }
  .hc__text { width: 100%; padding: 0 16px; }
  .hc__media { width: 100%; padding: 80px 16px 6.5px; }
  .hc__media img { aspect-ratio: 328 / 218.66; }
}

/* desktop-only measure caps that reproduce spec's line breaks */
@media (min-width: 1024px) {
  [data-desk-w="791"] { max-width: 791.27px; }
}
@media (min-width: 1024px) {
  /* spec: media column does not add to row height */
  .hs__media { position: relative; }
  .hs__media-in { position: absolute; left: 14.2857%; right: 0; top: 0; }   /* spec: media 32px from row top, overflows downward */
}

/* ==========================================================================
   Form hero, 1-column (1.6)
   ========================================================================== */
.hf__text { width: 66.6667%; margin: 0 auto; padding: 96px 16px 16px; }
.hf__intro { display: flex; flex-direction: column; align-items: center; text-align: center; }
.hf__h1 { font: 600 48px/57.6px var(--f-display); letter-spacing: -0.96px; color: var(--c-ink); padding-bottom: 16px; }
.hf__p { font: 400 16px/24px var(--f-body); color: var(--c-ink); text-align: center; }
.hf__intro .hf__p { padding-bottom: 40px; }
.hf__body { display: flex; flex-direction: column; gap: 8px; padding-top: 64px; }
.callout { background: #f5f7fa; border-left: 3px solid var(--c-blue); border-radius: 6px; padding: 16px 16px 16px 19px; }
.callout p { padding-bottom: 16px; font: 400 16px/24px var(--f-body); color: var(--c-ink-2); }
.hf__p--a { padding-top: 39px; }
.hf__p--b { padding-top: 55.75px; padding-bottom: 0.25px; }
.dot-list { list-style: none; margin: 0; padding: 8px 0 0 15px; display: flex; flex-direction: column; gap: 8px; }
.dot-list li { display: flex; justify-content: center; gap: 5.5px; font: 400 16px/24px var(--f-body); color: var(--c-ink); text-align: center; }
.dot-list li::before { content: "•"; color: #00857f; }

.hf__form-wrap { padding: 88px 16px 0; display: flex; justify-content: center; }
.fcard { width: 100%; max-width: 554px; background: #fff; border: 1px solid var(--c-rule-2); padding: 33px 33px 41px; display: flex; flex-direction: column; gap: 32px; }
.fcard__h { font: 600 26px/31.2px var(--f-display); letter-spacing: -0.52px; color: var(--c-ink); text-align: center; padding-bottom: 16px; }
.fcard__body { display: flex; flex-direction: column; gap: 32px; }
.fform { display: flex; flex-direction: column; gap: 24px; padding-top: 4px; }
.fin { display: block; width: 100%; min-width: 190px; height: 44px; padding: 15.5px 9px 11.5px; margin: 0;
  background: #fff; border: 1px solid var(--c-rule-2); border-radius: 0;
  font: 400 14px/17px var(--f-body); color: var(--c-ink-2); }
.fin::placeholder { color: #757575; opacity: 1; }
.fin--first { height: 40px; padding: 11.5px 9px; }
.fsel { position: relative; }
.fsel select { appearance: none; -webkit-appearance: none; height: 48px; padding: 13px 33px 13px 9px; background: #fff; cursor: pointer; }
.fsel--compact select { height: 35px; padding: 8px 33px 8px 9px; }   /* spec: 35px at every breakpoint */
.fsel img { position: absolute; right: 11.4px; top: 50%; width: 16px; height: 16px; transform: translateY(-50%); pointer-events: none; }
.fsubmit-row { padding-top: 8px; }
.fsubmit { width: 100%; min-width: 150px; height: 50px; padding: 1px 0; background: var(--c-blue); border: 1px solid var(--c-blue); border-radius: 4px;
  font: 600 16px/30px var(--f-display); color: #fff; cursor: pointer; }
.flegal { font: 400 12px/18px var(--f-body); color: var(--c-ink); }
.flegal a { color: var(--c-blue); text-decoration: underline; text-decoration-thickness: 1px; text-underline-position: from-font; text-decoration-skip-ink: none; }

@media (max-width: 1023.98px) {
  .hf__text { width: 83.3333%; margin: 0; padding: 64px 16px 15px calc(16.6667% + 16px); }
  .hf__h1 { font-size: 31.7px; line-height: 38.1px; letter-spacing: -0.635px; padding-bottom: 16px; }
  .hf__body { padding-top: 48px; }
  .hf__form-wrap { padding-top: 72px; }
  .fcard__h { font-size: 22.5px; line-height: 27px; letter-spacing: -0.45px; }
  .fsel--compact select { height: 35px; padding-top: 8px; padding-bottom: 8px; }
}
@media (max-width: 767.98px) {
  .hf__text { width: 100%; padding: 48px 16px 15.2px; }
  .hf__h1 { font-size: 26.6px; line-height: 32px; letter-spacing: -0.53px; }
  .hf__body { padding-top: 32px; }
  .hf__p--a { padding-top: 31px; }
  .hf__form-wrap { padding-top: 104px; }
  .fcard__h { font-size: 18.3px; line-height: 22px; letter-spacing: -0.37px; }
  .fform { padding: 14px 10px 10px; }
}
/* spec: video media blocks have no bottom padding at any breakpoint (images keep 6.5px) */
.hc__media.hc__media--video, .hs__media-in.hs__media-in--video { padding-bottom: 0 !important; }
/* header bars: fluid up to 1300px (fixed 1300px overflowed between 1024 and 1300px) */
.gh-util__inner, .gh-main { width: 100%; max-width: 1300px; }
/* header buttons: 44px tall including the 2px border (spec py10 / px26 sits inside the border) */
.btn--hdr { padding: 8px 24px; }

/* ==========================================================================
   ONE BUTTON STYLE everywhere = the primary-nav buttons
   Inter Semibold 14px/24px · 44px tall incl. 2px border · 24px inner side padding · 4px radius
   ========================================================================== */
.btn, .btn--hero, .btn--hdr, .btn--lg, .fsubmit, .btn--ghost-w {
  font: 600 14px/24px "Inter", system-ui, sans-serif !important; letter-spacing: 0 !important;
  height: 44px; min-height: 0; min-width: 0; padding: 8px 24px; border-width: 2px; border-radius: 4px; box-sizing: border-box;
}
.btn--hero, .btn--lg { height: 44px !important; min-height: 0 !important; padding: 8px 24px !important; }
.fsubmit { height: 44px; padding: 8px 24px; }
.btn--ghost-w { height: 44px; padding: 8px 24px; }
.btn__ico { width: 14px; height: 14px; }
/* mobile hero CTAs may wrap to two lines: keep the style, let height grow from 44px */
@media (max-width: 767.98px) { .hero-ctas .btn--hero { height: auto !important; min-height: 44px !important; padding: 8px 24px !important; } }

/* tertiary: text link with arrow (and plain/underlined CTA links) */
.tlink, .dl-link, .ulink, .dqs__alt a { font: 600 14px/24px "Inter", system-ui, sans-serif !important; letter-spacing: 0 !important; }
.tlink { height: auto; padding-top: 0; }
.tlink__arrow { margin-top: 4.5px; }
@media (max-width: 767.98px) {
  .hero-ctas { flex-wrap: wrap; row-gap: 16px; }
  .hero-ctas .btn--hero { height: 44px !important; min-height: 0 !important; flex: 0 0 auto; white-space: nowrap; }
}
/* ==========================================================================
   Body modules (2.x) — shared
   ========================================================================== */
:root {
  --bm-gap: 127.2px;                 /* spec gap between modules (guideline: 120) */
  --c-gray-bg: #f5f7fa;
  --shadow-fig: 0 10px 20px 0 rgba(152,162,179,0.1), 0 2px 6px 0 rgba(152,162,179,0.25);
}
.bm-stack > .bm + .bm { margin-top: var(--bm-gap); }
.bm { position: relative; padding: 96px 0; }
.bm--plain { padding: 0; }
.bm--gray { background: var(--c-gray-bg); }
.bm__in { width: 100%; max-width: 1280px; margin: 0 auto; }

/* module header: topic / H2 / lede / CTA — centered in 8 of 12 columns */
.bm-head { width: 66.6667%; margin: 0 auto; padding: 0 16px; display: flex; flex-direction: column; align-items: center; text-align: center; }
.bm-head--left { margin: 0; align-items: flex-start; text-align: left; }
.topic { font: 600 16px/29.28px var(--f-body); letter-spacing: 1.6px; text-transform: uppercase; color: var(--c-ink); padding-bottom: 16px; }
.h2 { font: 600 48px/57.6px var(--f-display); letter-spacing: -0.96px; color: var(--c-ink); padding-bottom: 16px; }
.h3 { font: 600 32px/38.4px var(--f-display); letter-spacing: -0.64px; color: var(--c-ink); padding-bottom: 16px; }
.h4 { font: 600 26px/31.2px var(--f-display); letter-spacing: -0.52px; color: var(--c-ink); padding-bottom: 16px; }
.h5 { font: 600 20px/32px var(--f-display); color: var(--c-ink); }
.lede { font: 400 20px/30px var(--f-body); color: var(--c-ink); }
.body16 { font: 400 16px/24px var(--f-body); color: var(--c-ink); }
.bm-cta { padding-top: 40px; display: flex; gap: 24px; align-items: center; justify-content: center; }
.bm-head--left .bm-cta { justify-content: flex-start; }

/* figures */
