.qcar__slide .qsec { height: 100%; align-items: flex-start; }
.qattr--b::before { background: var(--c-blue); }
.qtopic { font: 600 16px/29.28px var(--f-body); letter-spacing: 1.6px; text-transform: uppercase; color: var(--c-blue); padding-bottom: 16px; margin-top: -0.75px; }
.qlegal { font: 400 14.1px/21.12px var(--f-body); color: var(--c-ink); text-align: center; }
.qlinks { display: flex; gap: 32px; align-items: center; padding-top: 16px; }
.ulink { font: 600 16px/24px var(--f-display); color: var(--c-blue); text-decoration: underline; text-decoration-thickness: 1px; text-underline-position: from-font; text-decoration-skip-ink: none; }
.qcar__dots { position: absolute; top: 673.81px; left: 0; right: 0; display: flex; justify-content: center; gap: 24px; height: 12px; }
.qcar__dots button { width: 12px; height: 12px; padding: 0; border: 0; border-radius: 50%; background: rgba(0,0,0,.25); cursor: pointer; }
.qcar__dots button[aria-current="true"] { background: var(--c-blue); }
.qcar__arrow { position: absolute; top: calc(50% + 7.9px); width: 21.213px; height: 21.213px; transform: translateY(-50%); padding: 0; border: 0; background: none; cursor: pointer; display: flex; align-items: center; justify-content: center; }
.qcar__arrow::before { content: ""; width: 15px; height: 15px; border-left: 2px solid var(--c-blue); border-top: 2px solid var(--c-blue); box-sizing: border-box; }
.qcar__arrow--prev { left: calc(50% - 593.11px); } .qcar__arrow--prev::before { transform: rotate(-45deg); }
.qcar__arrow--next { right: calc(50% - 593.11px); } .qcar__arrow--next::before { transform: rotate(135deg); }
/* icon/text grids */
.igrid { display: flex; gap: 64px; width: 1248px; max-width: calc(100% - 32px); margin: 0 auto; align-items: flex-start; }
