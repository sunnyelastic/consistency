.card__body { width: 100%; padding-bottom: 8px; display: flex; flex-direction: column; align-items: center; text-align: center; }
.card__foot { padding: 16px 0 8px; }
.bm-head .bm-cta--32 { padding-top: 32px; }
.logos { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; width: 1280px; max-width: 100%; margin: 0 auto; }
.logos a { flex: 1 0 0; max-width: 256px; min-width: 0; padding: 0 16px 6.5px; display: flex; justify-content: center; }
.logos img { width: 168.64px; height: 91px; max-width: 100%; object-fit: contain; }
/* quote */
.qsec { background: var(--c-gray-bg); padding: 80px 0; display: flex; justify-content: center; }
.qbox { max-width: 1020px; padding: 16px 16px 24px; }
.qbox > img { width: 104px; height: 72px; display: block; }
.qtext { font: 600 38px/49.4px var(--f-display); color: var(--c-ink); padding: 16px 0 40px; }
.qattr { position: relative; padding-left: 32px; }
