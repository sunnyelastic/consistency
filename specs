.itc__tab.is-open { background: #fff; border-left-color: var(--c-blue); border-bottom-color: transparent; box-shadow: 0 10px 20px 10px rgba(152,162,179,0.1), 0 2px 6px 0 rgba(152,162,179,0.25); }
