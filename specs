.thumb__foot { padding-bottom: 40px; }
.lbar { width: 1040px; max-width: calc(100% - 32px); margin: 0 auto; border: 1px solid var(--c-rule-2); border-radius: 10px; padding: 5px; display: flex; align-items: center; justify-content: center; }
